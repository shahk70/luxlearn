# LuxLearn environment configuration.
# Copy this file to .env and fill in your values. .env is git-ignored.

# WeatherAPI.com API key(s) for live sunrise/sunset + cloud-cover data.
# The app ships with bundled public keys, so this is fully optional — a
# fresh install works out of the box. Get more free keys at
# https://www.weatherapi.com/ if you want your own pool.
#
# WEATHERAPI_PRIVATE_KEYS (optional, keep in your local .env only):
#   Your own key(s), tried FIRST on every request, in order. They never
#   rotate randomly, so public releases don't burn their quota. Comma-separated.
#
# WEATHERAPI_KEYS (optional):
#   Extra keys joined with the bundled public pool (env keys come first).
#   Comma-separated; one is picked at random per request and a rejected key
#   (403/429 quota/blocked) retries with a different unused key.
# WEATHERAPI_KEYS=your-extra-key-1,your-extra-key-2
# WEATHERAPI_PRIVATE_KEYS=your-own-key-1,your-own-key-2

# Legacy single-key variable — still accepted; wins over the bundled pool.
# WEATHERAPI_KEY=your-key
