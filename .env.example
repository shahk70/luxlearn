# LuxLearn environment configuration.
# Copy this file to .env and fill in your values. .env is git-ignored.

# WeatherAPI.com API key(s) for live sunrise/sunset + cloud-cover data.
# Optional — without it the app falls back to cached location or default
# sunrise/sunset hours. Get a free key at https://www.weatherapi.com/
#
# Multiple keys can be comma-separated; one is picked at random per request
# and a rejected key (403/429 quota/blocked) automatically retries once with
# a different key.
WEATHERAPI_KEYS=your-key-1,your-key-2

# Legacy single-key variable — still accepted if WEATHERAPI_KEYS is unset.
# WEATHERAPI_KEY=your-key
