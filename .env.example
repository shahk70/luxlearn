# LuxLearn environment configuration.
# Copy this file to .env and fill in your values. .env is git-ignored.

# WeatherAPI.com API key(s) for live sunrise/sunset + cloud-cover data.
# Optional — without it the app falls back to cached location or default
# sunrise/sunset hours. Get a free key at https://www.weatherapi.com/
#
# WEATHERAPI_PRIVATE_KEYS (optional, keep in your local .env only):
#   Your own key(s), tried FIRST on every request, in order. They never
#   rotate randomly, so public releases don't burn their quota. Comma-separated.
#
# WEATHERAPI_KEYS (public by default):
#   Shared keys used when no private key is set or after all private keys
#   hit an error. Comma-separated; one is picked at random per request and
#   a rejected key (403/429 quota/blocked) retries with a different unused key.
WEATHERAPI_KEYS=your-key-1,your-key-2
# WEATHERAPI_PRIVATE_KEYS=your-own-key

# Legacy single-key variable — still accepted if WEATHERAPI_KEYS is unset.
# WEATHERAPI_KEY=your-key
